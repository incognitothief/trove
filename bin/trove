#!/usr/bin/env bash
# Thin wrapper around the trove CLI so you can run it from anywhere without
# fighting make's option parsing:
#
#   trove import /Volumes/T72/music/library/Ahwlee/Life2 --plan
#   trove query --limit 20
#
# All arguments are forwarded verbatim to `cargo run -p trove-cli`.
# Set CARGO_FEATURES=s3 when ~/.trove/config.toml points at a real bucket.
set -euo pipefail

# Resolve the repo root (the directory containing this script's parent), so the
# wrapper works regardless of the caller's current directory.
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
REPO_ROOT="$(dirname -- "$SCRIPT_DIR")"

CARGO="${CARGO:-cargo}"

FEATURE_ARGS=()
if [ -n "${CARGO_FEATURES:-}" ]; then
  FEATURE_ARGS=(--features "$CARGO_FEATURES")
fi

cd -- "$REPO_ROOT"
exec "$CARGO" run --quiet -p trove-cli "${FEATURE_ARGS[@]}" -- "$@"
